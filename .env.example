# Serveur de synchronisation de Windfall Planner — copier en .env (npm run env:init).

NODE_ENV=development
# RT_71 : http://localhost:3000/v1
PORT=3000

# Base de développement (docker-compose.yml, service « db »).
DATABASE_URL=postgresql://windfall:windfall@localhost:5432/windfall?schema=public
# Base de test (service « db-test »), utilisée par `npm test`.
DATABASE_URL_TEST=postgresql://windfall:windfall@localhost:5433/windfall_test?schema=public

# RT_71 : origines du client autorisées en développement — ng serve, ionic serve,
# npm run serve:pwa, APK Android (Capacitor).
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,http://localhost:8080,https://localhost

# RT_69 : version minimale de l'application acceptée (426 CLIENT_TOO_OLD en dessous).
MIN_CLIENT_VERSION=0.0.0

# RT_69 : « trust proxy » d'Express — false en local ; derrière un proxy, le
# nombre de sauts ou la liste des adresses de confiance.
TRUST_PROXY=false

# Journal d'accès (méthode, chemin, statut, durée).
LOG_REQUESTS=true
