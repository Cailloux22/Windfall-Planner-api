# Serveur de synchronisation de Windfall Planner — exemple de production.
# Copier en .env sur le serveur (droits 600, propriétaire de l'utilisateur du service)
# et remplacer chaque valeur entre <…>. Voir README.md, « Déploiement sur un serveur ».

NODE_ENV=production
# Le reverse proxy relaie vers ce port, qui reste sur la boucle locale.
PORT=3000

# Base dédiée avec un mot de passe fort (jamais windfall/windfall du développement).
DATABASE_URL=postgresql://windfall:<mot-de-passe-fort>@127.0.0.1:5432/windfall?schema=public

# RT_71 : origine de la version web (RT_59) et APK Android (Capacitor).
CORS_ORIGINS=https://<origine-de-la-version-web>,https://localhost

# RT_69 : version minimale de l'application acceptée (426 CLIENT_TOO_OLD en dessous).
# La relever pour forcer la mise à jour des applications trop anciennes.
MIN_CLIENT_VERSION=0.0.0

# RT_69 : « trust proxy » d'Express. loopback = un reverse proxy sur la même machine ;
# sinon les adresses du proxy. Jamais true : X-Forwarded-For serait falsifiable
# et la limitation de débit par IP contournable.
TRUST_PROXY=loopback

# Journal d'accès (méthode, chemin, statut, durée).
LOG_REQUESTS=true
